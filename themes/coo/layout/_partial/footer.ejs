<footer class="text-slate-700 dark:text-slate-300 bg-slate-200 dark:bg-slate-800 md:mt-14">
    <% if (page.layout !== "note" && !page._isNotePagination) { %>
        <div class="max-container mb-8 md:py-10 mx-auto">
            <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6 xl:gap-8">
                <!-- Top Cheatsheet -->
                <div>
                    <h3 class="text-lg font-semibold text-slate-900 dark:text-slate-100 mb-4 flex items-center">
                        Top <span class="text-slate-500">&nbsp;Cheatsheet</span>
                    </h3>
                    <div class="space-y-3">
                        <% 
                        const topPostsData = topPosts(3);
                        topPostsData.forEach(function(post, index) { 
                        %>
                            <a href="<%- url_for(post.path) %>" title="<%= post.title %> Cheatsheet - Popular Quick Reference" class="group flex items-center p-3 bg-white dark:bg-slate-700 rounded-lg border border-slate-200 dark:border-slate-600 hover:border-indigo-300 dark:hover:border-indigo-500 transition-all duration-200 hover:shadow-md">
                                <div class="w-8 h-8 flex items-center justify-center flex-shrink-0 mr-3 text-indigo-600">
                                    <%- icon(post.slug) %>
                                </div>
                                <div class="min-w-0 flex-1">
                                    <h4 class="font-medium text-sm text-slate-900 dark:text-slate-100 group-hover:text-indigo-600 dark:group-hover:text-indigo-400 truncate">
                                        <%= post.title %> <span class="text-slate-400">Cheatsheet</span>
                                    </h4>
                                    <p class="text-xs text-slate-500 dark:text-slate-400">Popular Quick Reference</p>
                                </div>
                            </a>
                        <% }); %>
                    </div>
                </div>

                <!-- Recent Cheatsheet -->
                <div>
                    <h3 class="text-lg font-semibold text-slate-900 dark:text-slate-100 mb-4 flex items-center">
                        Recent <span class="text-slate-500">&nbsp;Cheatsheet</span>
                    </h3>
                    <div class="space-y-3">
                        <% 
                        const recentPosts = site.posts.sort('date', -1).filter(post => post.layout !== "note").data.slice(0, 3);
                        recentPosts.forEach(function(post, index) { 
                        %>
                            <a href="<%- url_for(post.path) %>" title="<%= post.title %> Cheatsheet - Latest Quick Reference" class="group flex items-center p-3 bg-white dark:bg-slate-700 rounded-lg border border-slate-200 dark:border-slate-600 hover:border-blue-300 dark:hover:border-blue-500 transition-all duration-200 hover:shadow-md">
                                <div class="w-8 h-8 flex items-center justify-center flex-shrink-0 mr-3 text-blue-600">
                                    <%- icon(post.slug) %>
                                </div>
                                <div class="min-w-0 flex-1">
                                    <h4 class="font-medium text-sm text-slate-900 dark:text-slate-100 group-hover:text-blue-600 dark:group-hover:text-blue-400 truncate">
                                        <%= post.title %> <span class="text-slate-400">Cheatsheet</span>
                                    </h4>
                                    <p class="text-xs text-slate-500 dark:text-slate-400">Latest Quick Reference</p>
                                </div>
                            </a>
                        <% }); %>
                    </div>
                </div>

                <!-- Logo Area -->
                <div class="text-left">
                    <div class="mb-4">
                        <%- partial('_partial/index/logo', { icon: true, theme: 'light' }) %>
                    </div>
                    <p class="text-sm text-slate-600 dark:text-slate-400 mb-4">
                        <%= (theme.footer && theme.footer.tagline) || config.description %>
                    </p>
                    <div class="space-y-2 text-sm">
                        <% ((theme.footer && theme.footer.links) || []).forEach(function (link) { %>
                        <div><a href="<%- url_for(link.url) %>" title="<%= link.label %>" class="text-slate-600 dark:text-slate-400 hover:text-indigo-600 dark:hover:text-indigo-400"><%= link.label %></a></div>
                        <% }); %>
                    </div>
                    <% if (theme.features && theme.features.share) { %>
                    <div class="mt-4">
                        <%- partial('share', { extra: 'justify-start' }) %>
                    </div>
                    <% } %>
                </div>
            </div>
        </div>
    <% } %>
    <div class="max-container flex flex-col items-center">
        <p class="pt-2 md:pt-3 text-slate-500 text-sm text-center w-full">
            © <%= new Date().getFullYear() %> <%= config.title %>
        </p>
        <% if (!theme.footer || theme.footer.credit !== false) { const up = upstream(); %>
        <p class="pb-2 md:pb-3 text-slate-500 text-xs text-center w-full">
            Built on <a href="<%- up.repo %>" rel="noopener noreferrer" target="_blank" class="underline hover:text-indigo-600 dark:hover:text-indigo-400"><%= up.name %></a>
            by <%= up.author %>, released under the GPL-3.0 license.
            <% if (up.donate) { %>Like it? <a href="<%- up.donate %>" rel="noopener noreferrer" target="_blank" class="underline hover:text-indigo-600 dark:hover:text-indigo-400">Support the original author</a>.<% } %>
        </p>
        <% } %>
    </div>
</footer>
