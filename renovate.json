{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":semanticCommits", "group:allNonMajor"],
  "timezone": "Europe/Copenhagen",
  "schedule": ["before 6am on monday"],
  "labels": ["dependencies"],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 6am on the first day of the month"]
  },
  "packageRules": [
    {
      "description": "Merge non-major updates on their own once CI is green",
      "matchUpdateTypes": ["minor", "patch", "pin", "digest", "lockFileMaintenance"],
      "automerge": true
    },
    {
      "description": "Node is pinned in .nvmrc, package.json engines and the Dockerfile; bump them together",
      "matchPackageNames": ["node"],
      "groupName": "node"
    },
    {
      "description": "pnpm is pinned in package.json and the Dockerfile; bump them together",
      "matchPackageNames": ["pnpm"],
      "groupName": "pnpm"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Node major used by the Docker image (FROM node:${NODE_VERSION}-alpine)",
      "managerFilePatterns": ["/^Dockerfile$/"],
      "matchStrings": ["ARG NODE_VERSION=(?<currentValue>\\d+)\\n"],
      "depNameTemplate": "node",
      "datasourceTemplate": "node-version",
      "versioningTemplate": "node"
    },
    {
      "customType": "regex",
      "description": "pnpm version installed in the Docker image",
      "managerFilePatterns": ["/^Dockerfile$/"],
      "matchStrings": ["ARG PNPM_VERSION=(?<currentValue>[\\d.]+)\\n"],
      "depNameTemplate": "pnpm",
      "datasourceTemplate": "npm"
    }
  ]
}
